// -*- mode:c++ -*-

//////////////////////////////////////////////////////////////////////
//
// RISC-V cache-block operation instructions
//

def template CacheBlockZeroDeclare {{
    class %(class_name)s : public Store
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);

        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          Trace::InstRecord *) const override;

        std::string generateDisassembly(Addr pc,
            const loader::SymbolTable *symtab) const override;
    };
}};

def template CacheBlockZeroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : Store("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
        memAccessFlags = Request::CACHE_BLOCK_ZERO;
    }
}};

def template CacheBlockZeroExecute {{
    Fault
    %(class_name)s::execute(
        ExecContext *xc, Trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;
        %(memacc_code)s;

        constexpr unsigned CboBlockBytes = 64;
        Fault fault = writeMemAtomic(
            xc, nullptr, EA, CboBlockBytes, memAccessFlags, nullptr,
            std::vector<bool>(CboBlockBytes, true));
        if (fault != NoFault)
            return fault;

        %(op_wb)s;

        return NoFault;
    }

    Fault
    %(class_name)s::initiateAcc(
        ExecContext *xc, Trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;
        %(memacc_code)s;

        constexpr unsigned CboBlockBytes = 64;
        Fault fault = writeMemTiming(
            xc, nullptr, EA, CboBlockBytes, memAccessFlags, nullptr,
            std::vector<bool>(CboBlockBytes, true));
        if (fault != NoFault)
            return fault;

        %(op_wb)s;

        return NoFault;
    }

    Fault
    %(class_name)s::completeAcc(
        PacketPtr pkt, ExecContext *xc, Trace::InstRecord *traceData) const
    {
        return NoFault;
    }

    std::string
    %(class_name)s::generateDisassembly(
        Addr pc, const loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << mnemonic << " (" << registerName(RegId(IntRegClass, RS1))
           << ')';
        return ss.str();
    }

}};

def format CacheBlockZero() {{
    iop = InstObjParams(name, Name, 'Store',
        {'ea_code': '''
            constexpr Addr CboBlockMask = 64 - 1;
            EA = Rs1 & ~CboBlockMask;
        ''',
        'memacc_code': '''
            Mem_ud = 0;
        '''},
        ['IsStore', 'IsOper64'])

    header_output = CacheBlockZeroDeclare.subst(iop)
    decoder_output = CacheBlockZeroConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = CacheBlockZeroExecute.subst(iop)
}};
