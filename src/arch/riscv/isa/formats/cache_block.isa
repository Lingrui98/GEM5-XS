// -*- mode:c++ -*-

//////////////////////////////////////////////////////////////////////
//
// RISC-V cache-block operation instructions
//

def template CacheBlockZeroDeclare {{
    class %(class_name)s : public RiscvMacroInst
    {
      public:
        %(class_name)s(ExtMachInst machInst);

        std::string generateDisassembly(Addr pc,
            const loader::SymbolTable *symtab) const override;
    };

    class %(class_name)sMicro : public RiscvMicroInst
    {
      private:
        %(reg_idx_arr_decl)s;
        uint8_t microIdx;
        Request::Flags memAccessFlags;

      public:
        %(class_name)sMicro(ExtMachInst machInst, uint8_t microIdx);

        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          Trace::InstRecord *) const override;

        std::string generateDisassembly(Addr pc,
            const loader::SymbolTable *symtab) const override;
    };
}};

def template CacheBlockZeroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : RiscvMacroInst("%(mnemonic)s", machInst, %(op_class)s)
    {
        for (uint8_t idx = 0; idx < 8; ++idx) {
            StaticInstPtr microop = new %(class_name)sMicro(machInst, idx);
            microop->setDelayedCommit();
            microop->setFlag(IsStore);
            this->microops.push_back(microop);
        }

        this->microops.front()->setFirstMicroop();
        this->microops.back()->setLastMicroop();
    }

    %(class_name)sMicro::%(class_name)sMicro(
        ExtMachInst machInst, uint8_t _microIdx)
        : RiscvMicroInst("%(mnemonic)s", machInst, %(op_class)s),
          microIdx(_microIdx),
          memAccessFlags(0)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
    }
}};

def template CacheBlockZeroExecute {{
    Fault
    %(class_name)sMicro::execute(
        ExecContext *xc, Trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;
        %(memacc_code)s;

        Fault fault =
            writeMemAtomicLE(xc, traceData, Mem, EA, memAccessFlags, nullptr);
        if (fault != NoFault)
            return fault;

        %(op_wb)s;

        return NoFault;
    }

    Fault
    %(class_name)sMicro::initiateAcc(
        ExecContext *xc, Trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;
        %(memacc_code)s;

        Fault fault =
            writeMemTimingLE(xc, traceData, Mem, EA, memAccessFlags, nullptr);
        if (fault != NoFault)
            return fault;

        %(op_wb)s;

        return NoFault;
    }

    Fault
    %(class_name)sMicro::completeAcc(
        PacketPtr pkt, ExecContext *xc, Trace::InstRecord *traceData) const
    {
        return NoFault;
    }

    std::string
    %(class_name)s::generateDisassembly(
        Addr pc, const loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << mnemonic << " (" << registerName(RegId(IntRegClass, RS1))
           << ')';
        return ss.str();
    }

    std::string
    %(class_name)sMicro::generateDisassembly(
        Addr pc, const loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << mnemonic << '[' << static_cast<unsigned>(microIdx) << "] ("
           << registerName(srcRegIdx(0)) << ')';
        return ss.str();
    }
}};

def format CacheBlockZero() {{
    macro_iop = InstObjParams(name, Name, 'RiscvMacroInst', '', [])

    micro_iop = InstObjParams(name, Name, 'RiscvMicroInst',
        {'ea_code': '''
            constexpr Addr CboBlockBytes = 64;
            constexpr Addr CboStoreBytes = sizeof(uint64_t);
            EA = (Rs1 & ~(CboBlockBytes - 1)) + microIdx * CboStoreBytes;
        ''',
        'memacc_code': '''
            Mem_ud = 0;
        '''},
        ['IsStore', 'IsOper64'])

    header_output = CacheBlockZeroDeclare.subst(micro_iop)
    decoder_output = CacheBlockZeroConstructor.subst(micro_iop)
    decode_block = BasicDecode.subst(macro_iop)
    exec_output = CacheBlockZeroExecute.subst(micro_iop)
}};
